# Runtime / user data — never commit
config.json
history.json
perf.log
error.log
update_notice.txt
relaunch.log
_relaunch.ps1

# Python
__pycache__/
*.pyc
*.pyo

# Optional dictionary release artifact (published as a GitHub Release asset)
data/dictionary/*.sqlite3
data/dictionary/.dictionary-download-*.tmp

# Icon-generator preview scratch (tools/make_icons.py)
_preview-*.png
_small-*.png
_verify-*.png
_iconpreview.png

# OS
Thumbs.db
desktop.ini

# Local-only VS Code protection (not synced to other machines)
.vscode/

# Isolated macOS development build products (never release artifacts)
/macos/.build/
/macos/.swiftpm/
/tools/macos/.staging/
/tools/macos/.build/

# Maintainer-only work logs; public instructions live in docs/MACOS*.md.
/docs/MACOS_DEVELOPMENT.md
/docs/MACOS_TODO.md
/docs/ROADMAP.md
